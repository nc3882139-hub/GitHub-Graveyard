# Server Configuration
PORT=3000

# GitHub Configuration
# Get your personal access token from https://github.com/settings/tokens
# Scopes needed: repo (full control of private repositories)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# Webhook Configuration
# Generate a random secret to secure your webhook
# This must match the secret configured in your GitHub repository settings
WEBHOOK_SECRET=your_random_webhook_secret_here

# Environment
NODE_ENV=development
